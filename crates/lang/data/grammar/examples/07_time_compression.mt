// Time compression makes music play faster or slower
// >>2 makes it play twice as fast (half the duration)
// >>1/2 makes it play half as fast (double the duration)

start Variations

SlowPattern = :4c<1/4> :4d<1/4> :4e<1/4> :4f<1/4>
FastPattern = [>>2][SlowPattern]
Variations = SlowPattern FastPattern
