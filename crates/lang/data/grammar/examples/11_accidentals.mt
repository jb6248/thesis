// Using sharps and flats
// # for sharp, b for flat

start ScaleWithAccidentals

// C# major scale
ScaleWithAccidentals = :4c#<1/4> :4d#<1/4> :4e#<1/4> :4f#<1/4> :4g#<1/4> :4a#<1/4> :4b#<1/4> :5c#<1/4>

// Bb major scale pattern
BbScale = :4bb<1/4> :4c<1/4> :4d<1/4> :4eb<1/4> :4f<1/4> :4g<1/4> :4a<1/4> :4bb<1/4>
