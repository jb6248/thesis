// Building intervals from a starting pitch
// Shows common musical intervals using relative pitch

start Intervals

// Minor second (1 semitone)
MinorSecond = + .<1/4>

// Major second (2 semitones)
MajorSecond = + + .<1/4>

// Minor third (3 semitones)
MinorThird = + + + .<1/4>

// Major third (4 semitones)
MajorThird = + + + + .<1/4>

// Perfect fourth (5 semitones)
PerfectFourth = + + + + + .<1/4>

// Perfect fifth (7 semitones)
PerfectFifth = + + + + + + + .<1/4>

// Octave (12 semitones)
Octave = + + + + + + + + + + + + .<1/4>

Intervals = :4c .<1/4> MinorSecond :4c MajorSecond :4c MinorThird :4c MajorThird :4c PerfectFourth :4c PerfectFifth :4c Octave
